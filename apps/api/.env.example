NODE_ENV="development"

API_PROTOCOL="http"
API_HOST="0.0.0.0"
API_PORT="3000"
API_PREFIX="api"
API_URL="http://localhost:3000/api"

FRONTEND_URL="http://localhost:5173"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="dpmc"
KEYCLOAK_CLIENT_ID="dpmc-api"
KEYCLOAK_CLIENT_SECRET="change-me"

# --- Behind the nginx TLS proxy (docker compose --profile tls) ---
# See deploy/README.md. Uncomment to serve everything over HTTPS:
# API_PROTOCOL="https"
# API_URL="https://localhost/api"
# FRONTEND_URL="https://localhost"
# KEYCLOAK_URL="https://localhost:8443"

SESSION_ENCRYPTION_KEY="ZHBtYy1kZXYtc2Vzc2lvbi1rZXktMzItYnl0ZXMhISE="
SESSION_COOKIE_NAME="dpmc.sid"
OAUTH_COOKIE_NAME="dpmc.oauth"

COOKIE_DOMAIN="localhost"
COOKIE_MAX_AGE="10000"

WORKER_REGISTRATION_TOKEN="dev-worker-registration-token-min20chars"

WORKER_OFFLINE_THRESHOLD_S="60"

# S3 / MinIO — product byte storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="admin"
S3_SECRET_KEY="adminadmin"
S3_BUCKET="dpmc"
S3_FORCE_PATH_STYLE="true"

# Absolute path to the repo's `data/warhol` directory on the Docker HOST.
WARHOL_DATA_ROOT="/path/to/repo/data/warhol"

# DPMC CLI — configuration
#
# Copy this file to apps/cli/.env and edit as needed.
# Real env vars (export DPMC_*) take precedence over .env contents.

# NestJS API base URL (must include the /api prefix)
DPMC_API_URL=http://localhost:3000/api

# Keycloak base URL and realm used for OAuth 2.0 Device Authorization
DPMC_KEYCLOAK_URL=http://localhost:8080
DPMC_KEYCLOAK_REALM=dpmc

# OAuth client id (must be a public client with device grant enabled)
DPMC_CLIENT_ID=dpmc-api

# Where to store the credentials file (mode 0600).
# Defaults to $XDG_CONFIG_HOME/dpmc or ~/.config/dpmc.
# DPMC_CONFIG_DIR=

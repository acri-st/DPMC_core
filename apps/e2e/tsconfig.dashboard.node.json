{
  "extends": "./tsconfig.dashboard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.dashboard.node.tsbuildinfo",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "src/dashboard/server.ts",
    "src/dashboard/**/*.ts",
    "src/setup/**/*.ts",
    "src/constants/**/*.ts"
  ],
  "exclude": ["src/dashboard/**/*.tsx"]
}

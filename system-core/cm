#!/bin/pgbash

source ${LTA_HOME}/definitions.include

# List the pool contents
list_pool_list() {
  CONNECT_TODB >/dev/null
  select host_id, hostname, id, available, comment
  from processing.pool as p, processing.hosts as h, processing.pool_x_hosts as pxh
  where h.host_id=pxh.hosts and p.id=pxh.pool
  order by id, hostname;
  DISCONNECT all; >/dev/null
}

# Lists the jobs with a specified status

list_jobs() {
  CURRENT_STATE=$1
  if [ ! -z "$CURRENT_STATE" ]; then
    CONNECT_TODB >/dev/null
    select * 
    from processing.batch
    where state = '$CURRENT_STATE';
    DISCONNECT all; >/dev/null
  else
    CONNECT_TODB >/dev/null
    select * 
    from processing.batch;
    DISCONNECT all; >/dev/null
  fi
}

# List the CPU state

list_cpu() {
  CONNECT_TODB >/dev/null
  select host_id, hostname, available, processing_dir
  from processing.hosts
  order by available;
  DISCONNECT all; >/dev/null
}

# Disable a CPU_ID

disable_cpu() {
  CONNECT_TODB >/dev/null
  update processing.hosts
  set available = false
  where host_id = $1;
  DISCONNECT all; >/dev/null
}

# Enable a CPU_ID

enable_cpu() {
  CONNECT_TODB >/dev/null
  update processing.hosts
  set available = true
  where host_id = $1;
  DISCONNECT all; >/dev/null
}

# Empty the batch table 

empty_batch() {
  ID=6
  CONNECT_TODB >/dev/null
  delete from processing.parameters_set where id in (select batch_id from processing.batch where request_id=-${ID});
  delete from processing.top where batch_id in (select batch_id from processing.batch where request_id=-${ID});
  delete from processing.batch_x_product where batch in (select batch_id from processing.batch where request_id=-${ID});
  delete from processing.batch where request_id=-${ID};
  select * from processing.batch where request_id=-${ID};
  DISCONNECT all; >/dev/null
}

# Delete the scratch job from the batch table 

delete_scratch_batch() {
  CONNECT_TODB >/dev/null
  select processing.delete_job(batch_id)
  from processing.batch
  where state = 'Scratch'
  ;
  DISCONNECT all; >/dev/null
}

# Clean the processing.top table

clean_top() {
  CONNECT_TODB >/dev/null
  if [ "$1" = "all" ]; then
    delete 
    from processing.top
    ;
  else
    delete 
    from processing.top
    where batch_id = $1;
  fi
  DISCONNECT all; >/dev/null
  wait_for_return
}

# Delete a running job

delete_job() {
  CONNECT_TODB >/dev/null
  select hostname_id, pid into :HOSTNAME_ID, :PID
  from processing.top
  where batch_id = $1;
  echo HOSTNAME_ID=$HOSTNAME_ID
  echo PID=$PID
  select hostname, processing_dir into :HOSTNAME, :PROCESSING_DIR
  from processing.hosts
  where host_id=$HOSTNAME_ID;
  echo HOSTNAME=$HOSTNAME
  echo ssh -l dpmc $HOSTNAME kill -9 $PID
  ssh -l dpmc $HOSTNAME kill -9 $PID
  delete from processing.top where batch_id = $1;
  DISCONNECT all; >/dev/null
  wait_for_return
}

# Modify the status of the jobs

set_jobs_state() {
  echo $CURRENT_STATE to $NEW_STATE
  CONNECT_TODB >/dev/null
  update processing.batch
  set state = '$NEW_STATE'
  where state = '$CURRENT_STATE'
  ;
  DISCONNECT all; >/dev/null
# Remove the scheduler lock file if needed
  if [ -f $LOCK_FILE ]; then
    /bin/rm -f LOCK_FILE
  fi
  if [ -f $LOCK_FILE2 ]; then
    /bin/rm -f LOCK_FILE2
  fi
}

# Wait for <return> key to continue

wait_for_return() {
  echo
  echo " Press <return> key to continue... "
  echo
  read WK
}

# Main menu loop

KEY=""

until [ "$KEY" = "Q" -o "$KEY" = "q" ]; do

  clear

  echo 
  echo " --------------------------------------------------------------- "
  echo "                     CLUSTER Management Tool                     "
  echo " --------------------------------------------------------------- "
  echo 
  echo " LA. List all jobs                 "
  echo " LS. List jobs in Suspended state  LQ. List jobs in Queued state "
  echo " LR. List jobs in Running state    "
  echo 
  echo " QS. Queued -> Suspended           SQ. Scratch -> Queued "
  echo " RS. Running -> Suspended          SD. Suspended -> Done "
  echo " SS. Suspended -> Scratch          LQ. Launched -> Queued"
  echo " DS. Delete the scratch jobs       BI. batch info "
  echo 
  echo " T.  Cluster status                TA. Cluster status (loop)"
  echo " LC. List the CPU state            HI. Hosts information"
  echo " R.  Enable a CPU                  S.  Disable a CPU"
  echo " PD. Delete system from pool       PA. Add a system to a pool"
  echo 
  echo " K.  Delete a batch running - batch+top "
  echo 
  echo " W.  Create lock file               Y. Delete lock file "
  echo 
  echo " Q.  Exit "
  echo 

  read KEY

  LOCK_FILE=$SYSTEM_CORE/.schedulerlock
  LOCK_FILE2=$SYSTEM_CORE/.schedulerstop

  if [ "$KEY" = "T" -o "$KEY" = "t" ]; then

    ${LTA_HOME}/system-core/cluster-top.sh manual

  elif [ "$KEY" = "CI" -o "$KEY" = "ci" ]; then

    CONNECT_TODB >/dev/null
    select * from public.batch_per_product_type_and_cycle;
    DISCONNECT all; >/dev/null
    wait_for_return

  elif [ "$KEY" = "BI" -o "$KEY" = "bi" ]; then

    echo
    echo " Give the batch ID or 0 to stop: "
    read BATCH_ID
    if [ "$BATCH_ID" != "0" ]; then
      batch_info ${BATCH_ID}
    fi
    wait_for_return

  elif [ "$KEY" = "TA" -o "$KEY" = "ta" ]; then

#    xterm -geometry 200x45 -fn fixed -bg aquamarine -fg blue \
#	 -e ${LTA_HOME}/system-core/cluster-top.sh &
    ${LTA_HOME}/system-core/cluster-top.sh freq 5

  elif [ "$KEY" = "LS" -o "$KEY" = "ls" ]; then

    CURRENT_STATE="Suspended"
    list_jobs $CURRENT_STATE
    wait_for_return

  elif [ "$KEY" = "LQ" -o "$KEY" = "lq" ]; then

    CURRENT_STATE="Queued"
    list_jobs $CURRENT_STATE
    wait_for_return

  elif [ "$KEY" = "LE" -o "$KEY" = "le" ]; then

    CURRENT_STATE="Error"
    list_jobs $CURRENT_STATE
    wait_for_return

  elif [ "$KEY" = "LA" -o "$KEY" = "la" ]; then

    list_jobs
    wait_for_return

  elif [ "$KEY" = "LR" -o "$KEY" = "lr" ]; then

    CURRENT_STATE="Running"
    list_jobs $CURRENT_STATE
    wait_for_return

  elif [ "$KEY" = "QS" -o "$KEY" = "qs" ]; then

    CURRENT_STATE="Queued"
    NEW_STATE="Suspended"
    set_jobs_state

  elif [ "$KEY" = "LQ" -o "$KEY" = "lq" ]; then

    CURRENT_STATE="Launched"
    NEW_STATE="Queued"
    set_jobs_state

  elif [ "$KEY" = "SQ" -o "$KEY" = "sq" ]; then

    CURRENT_STATE="Scratch"
    NEW_STATE="Queued"
    set_jobs_state

  elif [ "$KEY" = "SS" -o "$KEY" = "ss" ]; then

    CURRENT_STATE="Suspended"
    NEW_STATE="Scratch"
    set_jobs_state

  elif [ "$KEY" = "RS" -o "$KEY" = "rs" ]; then

    CURRENT_STATE="Running"
    NEW_STATE="Suspended"
    set_jobs_state

  elif [ "$KEY" = "SD" -o "$KEY" = "sd" ]; then

    CURRENT_STATE="Suspended"
    NEW_STATE="Done"
    set_jobs_state

  elif [ "$KEY" = "PL" -o "$KEY" = "pl" ]; then

    list_pool_list
    wait_for_return

  elif [ "$KEY" = "PD" -o "$KEY" = "pd" ]; then

    HOST_ID=" "
    POOL_ID=" "
    until [ "$HOST_ID" = "0" ]; do
      list_pool_list
      echo
      echo " To suppress a host from a pool: "
      echo
      echo " Give the pool id or -1 to stop: "
      read POOL_ID
      if [ ${POOL_ID} -eq -1 ]; then
        break
      fi
      echo " Give the host_id, -1 for all or 0 to stop: "
      read HOST_ID
      if [ ${HOST_ID} -lt 0 ]; then
        CONNECT_TODB >/dev/null
        delete
        from processing.pool_x_hosts
        where pool = $POOL_ID;
        DISCONNECT all; >/dev/null
        list_pool_list
        break
      fi
      if [ ${HOST_ID} -eq 0 ]; then
        break
      fi
      CONNECT_TODB >/dev/null
      delete
      from processing.pool_x_hosts
      where hosts = $HOST_ID and pool = $POOL_ID;
      DISCONNECT all; >/dev/null
    done
    wait_for_return

  elif [ "$KEY" = "PA" -o "$KEY" = "pa" ]; then

    HOST_ID=" "
    POOL_ID=" "
    until [ "$HOST_ID" = "0" ]; do
      list_pool_list
      echo
      echo " To add a host to a pool: "
      echo
      echo " Give the pool id or -1 to stop: "
      read POOL_ID
      if [ ${POOL_ID} -eq -1 ]; then
        break
      fi
      echo " Give the host_id or 0 to stop: "
      read HOST_ID
      if [ ${HOST_ID} -eq 0 ]; then
        break
      fi
      CONNECT_TODB >/dev/null
      insert into processing.pool_x_hosts(pool,hosts) values($POOL_ID,$HOST_ID);
      DISCONNECT all; >/dev/null
    done
    wait_for_return

  elif [ "$KEY" = "PT" -o "$KEY" = "pt" ]; then

    HOST_ID=" "
    POOL1_ID=" "
    POOL2_ID=" "
    until [ "$HOST_ID" = "0" ]; do
      list_pool_list
      echo
      echo " To move a host fomr a pool to another pool: "
      echo
      echo " Give the host_id or 0 to stop: "
      read HOST_ID
      if [ ${HOST_ID} -eq 0 ]; then
        break
      fi
      echo " Give the initial pool id or 0 to stop: "
      read POOL1_ID
      if [ ${POOL1_ID} -eq 0 ]; then
        break
      fi
      echo " Give the final pool id or 0 to stop: "
      read POOL2_ID
      if [ ${POOL2_ID} -eq 0 ]; then
        break
      fi
      CONNECT_TODB >/dev/null
      delete
      from processing.pool_x_hosts
      where hosts = $HOST_ID and pool = $POOL1_ID;
      insert into processing.pool_x_hosts(pool,hosts) values($POOL2_ID,$HOST_ID);
      DISCONNECT all; >/dev/null
    done
    wait_for_return

  elif [ "$KEY" = "1" ]; then

    CONNECT_TODB >/dev/null
    select count(*)
    from processing.batch
    where state = 'Running'
    and request_id < 0 ;
    DISCONNECT all; >/dev/null
    wait_for_return

  elif [ "$KEY" = "X" -o "$KEY" = "x" ]; then

    empty_batch
    wait_for_return

  elif [ "$KEY" = "DS" -o "$KEY" = "ds" ]; then

    delete_scratch_batch
    wait_for_return

  elif [ "$KEY" = "LC" -o "$KEY" = "lc" ]; then

    list_cpu
    wait_for_return

  elif [ "$KEY" = "R" -o "$KEY" = "r" ]; then

    CPU_ID=" "
    until [ "$CPU_ID" = "0" ]; do
      list_cpu
      echo
      echo " Give the CPU id or 0 to stop: "
      read CPU_ID
      if [ "$CPU_ID" != "0" ]; then
        enable_cpu ${CPU_ID} 
      fi
    done

  elif [ "$KEY" = "S" -o "$KEY" = "s" ]; then

    CPU_ID=" "
    until [ "$CPU_ID" = "0" ]; do
      list_cpu
      echo
      echo " Give the CPU id or 0 to stop: "
      read CPU_ID
      if [ "$CPU_ID" != "0" ]; then
        disable_cpu ${CPU_ID} 
      fi
    done

  elif [ "$KEY" = "K" -o "$KEY" = "k" ]; then

    BATCH_ID=" "
    until [ "$BATCH_ID" = "0" ]; do
      echo
      echo " Give the batch id to be killed or 0 to stop: "
      read BATCH_ID
      if [ "$BATCH_ID" != "0" ]; then
        if [ ! -z "$BATCH_ID" ]; then
          delete_job ${BATCH_ID}
        fi
      fi
    done

  elif [ "$KEY" = "HI" -o "$KEY" = "hi" ]; then
  
    # Hosts information
    CONNECT_TODB >/dev/null
    select hosts.host_id, hosts.hostname, hosts.ncpu, hosts.ip_address, hosts_comment.description
    from
      processing.hosts, processing.hosts_comment
    where
      hosts.host_id=hosts_comment.host_id
      and hosts_comment.description not like ''
    order by hosts.hostname ;
    DISCONNECT all; >/dev/null
    wait_for_return

  fi

done

# Keep the build context source-only and reproducible: dependencies and build
# outputs are (re)generated inside the image, never copied from the host. Not
# excluding these lets stale local dist/ mask missing build steps (the API/web
# images compiled locally but failed in CI for exactly this reason).
**/node_modules
**/dist
**/build
**/.next
**/.turbo
**/.docusaurus
**/coverage

# Python worker virtualenv + caches (irrelevant to the JS images, very large).
**/.venv
**/__pycache__
**/.pytest_cache

# VCS / local noise
.git
.gitlab-ci.yml
**/*.log

# Local MinIO storage, S3 buckets and seed fixtures — large, never needed in an
# image. NOT a blanket `data` exclusion: job images bake their own sources —
# warhol (data/warhol/<scripts> + _lib) and dpmc_tst (data/dpmc_tst/components +
# conf) must stay in the build context. Only the heavy/runtime dirs under data/
# are excluded (warhol/runs = job outputs; data/seed = generated DPMC_TST_*.txt).
data/.minio.sys
data/dpmc
data/warhol/runs
